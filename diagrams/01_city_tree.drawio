&gt;TERMINAL: a black box, one summary document&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="445" width="240" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;N6 Bus Network Project&lt;/b&gt;&lt;br&gt;bus routes&lt;br&gt;7 files · 12 test questions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="605" width="240" height="95" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Trap: versions and a duplicate&lt;/b&gt;&lt;br&gt;D10 version 1 says 120 buses, version 2 says 135. The right answer uses the newest.&lt;br&gt;D12 has an exact copy: cite it once." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="420" width="330" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Trap: a contradiction and a scan&lt;/b&gt;&lt;br&gt;D11 says Route 12 is the busiest, D16 says Route 7. The answer must say the sources disagree.&lt;br&gt;D19 is a scanned page: the vision model reads it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="570" width="330" height="130" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Trap: a black box&lt;/b&gt;&lt;br&gt;Questions about the inside of a terminal node get "insufficient knowledge", never a guess.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="260" width="330" height="95" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;dashed=1;endArrow=none;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;dashed=1;endArrow=none;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;dashed=1;endArrow=none;" edge="1" parent="1" source="c10" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue: a normal node&lt;br&gt;Orange: a terminal node&lt;br&gt;Red: a planted trap the tests check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="330" height="95" as="geometry"/></mxCell><mxCell id="c27" value="Totals: 20 documents in 22 files (one older version, one copy) · 26 questions in the answer key · 7 issues · 6 people. Data: &lt;i&gt;registry/node_layer_registry.csv&lt;/i&gt;, &lt;i&gt;case_study/&lt;/i&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
