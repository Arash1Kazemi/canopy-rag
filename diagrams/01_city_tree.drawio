<mxfile host="drawio"><diagram name="1 The city tree" id="1_The_city_tree"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;1. The test city: 7 nodes in 4 layers&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Each box is a node (a part of the organization). Arrows point from a parent to its child. Hard rule H01: a question is answered only from the documents of the node that asks it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Layer 0: governance&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1060" height="140" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Layer 1: departments&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1060" height="140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Layer 2: agencies&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1060" height="140" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Layer 3: projects&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSiz