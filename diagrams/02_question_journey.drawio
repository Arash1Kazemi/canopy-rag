<mxfile host="drawio"><diagram name="2 A question's journey" id="2_A_question's_journ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;2. A question's journey (how the baseline answers)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value='Top row runs once, to prepare the documents. Bottom row runs for every question. Example: Q01 "How many buses does the Transit Agency have now?" asked at N4.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;ONCE: prepare the documents (indexing)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="95" width="600" height="25" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;22 files&lt;/b&gt;&lt;br&gt;Markdown documents of the 7 nodes&lt;br&gt;&lt;i&gt;case_study/documents&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Read the scanned page&lt;/b&gt;&lt;br&gt;D19 is an image. glm-ocr turns it into text." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cut into chunks&lt;/b&gt;&lt;br&gt;80 words each, 15 words overlap with the next chunk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Turn each chunk into numbers&lt;/b&gt;&lt;br&gt;qwen3-embedding-0.6b makes a vector: a list of numbers that stands for the meaning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="230" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;every chunk + its vector + its node (N0 to N6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;EVERY QUESTION&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="600" height="25" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;asked at a node&lt;br&gt;Q01 at N4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="160" height="95" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Question to numbers&lt;/b&gt;&lt;br&gt;same embedding model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="320" width="160" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Keep only N4's chunks&lt;/b&gt;&lt;br&gt;hard rule H01: never another node's documents" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="180" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Pick the 3 closest chunks&lt;/b&gt;&lt;br&gt;by cosine similarity: how much two vectors point the same way (1 = same meaning)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="320" width="210" height="95" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Fill the prompt&lt;/b&gt;&lt;br&gt;a versioned template from &lt;i&gt;prompts/&lt;/i&gt;: question + 3 chunks + rules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="190" height="95" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;The LLM writes the answer&lt;/b&gt;&lt;br&gt;phi4-mini, temperature 0, seed 42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="320" width="190" height="95" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="search here" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Answer with citations&lt;/b&gt;&lt;br&gt;"135 buses [D10_bus_fleet_inventory_v2]"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="480" width="190" height="95" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Grade it automatically&lt;/b&gt;&lt;br&gt;key facts + grading rules GR1 to GR5 (right facts? valid citations? refused when it should?)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="480" width="240" height="95" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Metric numbers&lt;/b&gt;&lt;br&gt;e.g. answer correctness 0.913&lt;br&gt;&lt;i&gt;results/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="190" height="95" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Why the example is a trap&lt;/b&gt;&lt;br&gt;Both versions of D10 were retrieved. The model chose version 2 (135) and cited it, so the answer is correct." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="380" height="95" as="geometry"/></mxCell><mxCell id="c33" value="Everything runs on the laptop through Ollama (127.0.0.1:11500). No internet: hard rule H06. Code: &lt;i&gt;baseline_runner/&lt;/i&gt; (chunking.py, retrieval.py, prompts.py, grading.py)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
