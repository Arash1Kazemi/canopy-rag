<mxfile host="drawio"><diagram name="1 The city tree" id="1_The_city_tree"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;1. The test city: 7 nodes in 4 layers&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Each box is a node (a part of the organization). Arrows point from a parent to its child. Hard rule H01: a question is answered only from the documents of the node that asks it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Layer 0: governance&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1060" height="140" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Layer 1: departments&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1060" height="140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Layer 2: agencies&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1060" height="140" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Layer 3: projects&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1060" height="140" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;N0 City Council&lt;/b&gt;&lt;br&gt;governance&lt;br&gt;3 files · 3 test questions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="125" width="240" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;N1 Transport Dept&lt;/b&gt;&lt;br&gt;transport&lt;br&gt;3 files · 2 test questions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="285" width="240" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;N2 Water Dept&lt;/b&gt;&lt;br&gt;water&lt;br&gt;2 files · 1 test question" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="285" width="240" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;N3 Housing Dept&lt;/b&gt;&lt;br&gt;housing&lt;br&gt;1 file · 2 test questions&lt;br&gt;&lt;i&gt;TERMINAL: a black box, one summary document&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="285" width="240" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;N4 Transit Agency&lt;/b&gt;&lt;br&gt;public transit&lt;br&gt;5 files · 5 test questions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="445" width="240" height="95" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;N5 Water Utility&lt;/b&gt;&lt;br&gt;water supply&lt;br&gt;1 file · 1 test question&lt;br&gt;&lt;i&gt;TERMINAL: a black box, one summary document&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="445" width="240" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;N6 Bus Network Project&lt;/b&gt;&lt;br&gt;bus routes&lt;br&gt;7 files · 12 test questions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="605" width="240" height="95" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Trap: versions and a duplicate&lt;/b&gt;&lt;br&gt;D10 version 1 says 120 buses, version 2 says 135. The right answer uses the newest.&lt;br&gt;D12 has an exact copy: cite it once." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="420" width="330" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Trap: a contradiction and a scan&lt;/b&gt;&lt;br&gt;D11 says Route 12 is the busiest, D16 says Route 7. The answer must say the sources disagree.&lt;br&gt;D19 is a scanned page: the vision model reads it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="570" width="330" height="130" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Trap: a black box&lt;/b&gt;&lt;br&gt;Questions about the inside of a terminal node get "insufficient knowledge", never a guess.' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1110" y="260" width="330" height="95" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;dashed=1;endArrow=none;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;dashed=1;endArrow=none;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;dashed=1;endArrow=none;" edge="1" parent="1" source="c10" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue: a normal node&lt;br&gt;Orange: a terminal node&lt;br&gt;Red: a planted trap the tests check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="330" height="95" as="geometry"/></mxCell><mxCell id="c27" value="Totals: 20 documents in 22 files (one older version, one copy) · 26 questions in the answer key · 7 issues · 6 people. Data: &lt;i&gt;registry/node_layer_registry.csv&lt;/i&gt;, &lt;i&gt;case_study/&lt;/i&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 A question's journey" id="2_A_question's_journ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;2. A question's journey (how the baseline answers)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value='Top row runs once, to prepare the documents. Bottom row runs for every question. Example: Q01 "How many buses does the Transit Agency have now?" asked at N4.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;ONCE: prepare the documents (indexing)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="95" width="600" height="25" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;22 files&lt;/b&gt;&lt;br&gt;Markdown documents of the 7 nodes&lt;br&gt;&lt;i&gt;case_study/documents&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Read the scanned page&lt;/b&gt;&lt;br&gt;D19 is an image. glm-ocr turns it into text." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cut into chunks&lt;/b&gt;&lt;br&gt;80 words each, 15 words overlap with the next chunk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Turn each chunk into numbers&lt;/b&gt;&lt;br&gt;qwen3-embedding-0.6b makes a vector: a list of numbers that stands for the meaning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="230" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;every chunk + its vector + its node (N0 to N6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="200" height="95" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;EVERY QUESTION&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="600" height="25" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;asked at a node&lt;br&gt;Q01 at N4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="160" height="95" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Question to numbers&lt;/b&gt;&lt;br&gt;same embedding model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="320" width="160" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Keep only N4's chunks&lt;/b&gt;&lt;br&gt;hard rule H01: never another node's documents" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="180" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Pick the 3 closest chunks&lt;/b&gt;&lt;br&gt;by cosine similarity: how much two vectors point the same way (1 = same meaning)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="320" width="210" height="95" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Fill the prompt&lt;/b&gt;&lt;br&gt;a versioned template from &lt;i&gt;prompts/&lt;/i&gt;: question + 3 chunks + rules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="190" height="95" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;The LLM writes the answer&lt;/b&gt;&lt;br&gt;phi4-mini, temperature 0, seed 42" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="320" width="190" height="95" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="search here" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Answer with citations&lt;/b&gt;&lt;br&gt;"135 buses [D10_bus_fleet_inventory_v2]"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="480" width="190" height="95" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Grade it automatically&lt;/b&gt;&lt;br&gt;key facts + grading rules GR1 to GR5 (right facts? valid citations? refused when it should?)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="480" width="240" height="95" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Metric numbers&lt;/b&gt;&lt;br&gt;e.g. answer correctness 0.913&lt;br&gt;&lt;i&gt;results/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="190" height="95" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Why the example is a trap&lt;/b&gt;&lt;br&gt;Both versions of D10 were retrieved. The model chose version 2 (135) and cited it, so the answer is correct." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="380" height="95" as="geometry"/></mxCell><mxCell id="c33" value="Everything runs on the laptop through Ollama (127.0.0.1:11500). No internet: hard rule H06. Code: &lt;i&gt;baseline_runner/&lt;/i&gt; (chunking.py, retrieval.py, prompts.py, grading.py)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 How we measure" id="3_How_we_measure"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;3. How we know if it works&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Left to right: from the questions we wrote to the targets the supervisor sets. Below: rules that must never break are tested pass or fail, not measured." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Answer key&lt;/b&gt;&lt;br&gt;26 questions, each with its node and the right sources&lt;br&gt;&lt;i&gt;case_study/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Key facts&lt;/b&gt;&lt;br&gt;what a right answer must contain&lt;br&gt;";" means and, "|" means or&lt;br&gt;&lt;i&gt;metrics/key_facts.csv&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="210" height="110" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;5 grading rules&lt;/b&gt;&lt;br&gt;GR1 key facts present&lt;br&gt;GR2 says "insufficient knowledge"&lt;br&gt;GR3 states the conflict&lt;br&gt;GR4 cites the duplicate once&lt;br&gt;GR5 citations valid' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="100" width="220" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;28 metrics&lt;/b&gt;&lt;br&gt;in 8 objectives (O1 to O8)&lt;br&gt;16 have a baseline now&lt;br&gt;&lt;i&gt;metrics/metrics.csv&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Baseline (part 2)&lt;/b&gt;&lt;br&gt;the first measured value of each metric" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="190" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Targets&lt;/b&gt;&lt;br&gt;set with the supervisor&lt;br&gt;&lt;b&gt;not set yet&lt;/b&gt;: never invent a number" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="190" height="110" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Some baseline numbers (from docs/baseline_report.md)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="700" height="25" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;0.913&lt;/b&gt;&lt;br&gt;Answer correctness" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;0.870&lt;/b&gt;&lt;br&gt;Citation validity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Correct refusal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Context recall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Version handling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Scanned text recovery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;0.572&lt;/b&gt;&lt;br&gt;Context precision&lt;br&gt;(many retrieved chunks are not needed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="245" height="75" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;0.000&lt;/b&gt;&lt;br&gt;Duplicate cited once&lt;br&gt;(the model cited D12 and its copy)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="285" y="380" width="245" height="75" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;0.70 s&lt;/b&gt; median question time&lt;br&gt;&lt;b&gt;37.5&lt;/b&gt; tokens per second" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="380" width="245" height="75" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;10 hard rules: tested, never measured&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="700" height="25" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Hard rules (examples)&lt;/b&gt;&lt;br&gt;H01 a node answers only from its own documents&lt;br&gt;H03 one active version per knowledge item&lt;br&gt;H06 runs with the network off&lt;br&gt;H09 every answer cites a source or says insufficient knowledge&lt;br&gt;&lt;i&gt;metrics/hard_rules.csv&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="525" width="420" height="130" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;64 unit tests&lt;/b&gt; (pytest)&lt;br&gt;fake models, no network&lt;br&gt;&lt;i&gt;tests/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="525" width="220" height="75" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;run_checks.py&lt;/b&gt;&lt;br&gt;6 validators over the data and pages&lt;br&gt;&lt;i&gt;tools/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="615" width="220" height="75" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Later (part 11): the LLM judge&lt;/b&gt;&lt;br&gt;a model scores transfer packages out of 20; below 18 is never sent up (H05). Judges have biases, so we check them against humans." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="525" width="400" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Roadmap and team" id="4_Roadmap_and_team"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;4. Roadmap and who does what&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The proposal has 16 parts. Green is done, blue is next. Names from the proposal, section 21." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Part 1&lt;/b&gt;&lt;br&gt;Start and domain discovery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Part 2&lt;/b&gt;&lt;br&gt;Offline models and baseline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Part 3&lt;/b&gt;&lt;br&gt;DDD architecture and domain model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Part 4&lt;/b&gt;&lt;br&gt;Document ingestion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Part 5&lt;/b&gt;&lt;br&gt;Versioning, chunking, duplicates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Part 6&lt;/b&gt;&lt;br&gt;Nodes, layers, hierarchy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Part 7&lt;/b&gt;&lt;br&gt;Issues and sub-issues" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Part 8&lt;/b&gt;&lt;br&gt;RAG retrieval and Q&amp;amp;A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1245" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Part 9&lt;/b&gt;&lt;br&gt;Executors and IKE relations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Part 10&lt;/b&gt;&lt;br&gt;LLM judge and quality control" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Part 11&lt;/b&gt;&lt;br&gt;Node cycles and upward transfer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Part 12&lt;/b&gt;&lt;br&gt;Projects, research, gaps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Part 13&lt;/b&gt;&lt;br&gt;RFP and proposals" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Part 14&lt;/b&gt;&lt;br&gt;Prompt testing and tuning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Part 15&lt;/b&gt;&lt;br&gt;Unit tests and hardening" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Part 16&lt;/b&gt;&lt;br&gt;Wrap-up and presentation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1245" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;The team for the next weeks&lt;/b&gt; (details: &lt;i&gt;docs/team_plan.md&lt;/i&gt;)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="900" height="25" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;You (lead)&lt;/b&gt;&lt;br&gt;Parts 3 and 4 built: review them with the supervisor&lt;br&gt;Then Part 5&lt;br&gt;Merge work, run the checks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Teammate A: questions&lt;/b&gt;&lt;br&gt;Write 10 unseen questions + key facts.&lt;br&gt;You never saw the prompts, so your questions are a fair test." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Teammate B: runs&lt;/b&gt;&lt;br&gt;Follow the operator guide: rerun with qwen3:4b-instruct, the Wi-Fi-off run, record ollama ps." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Teammate C: ingestion&lt;/b&gt;&lt;br&gt;Test the ingestion prototype on real Word, PDF and DOC files, and the image-only D19 PDF." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;The working rule&lt;/b&gt;&lt;br&gt;Teammates write only in &lt;i&gt;team/&amp;lt;name&amp;gt;/&lt;/i&gt;. The lead copies the work into the project, then runs the checks and the tests. So nobody breaks the project by accident." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="630" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
