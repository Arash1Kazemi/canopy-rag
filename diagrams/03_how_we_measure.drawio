<mxfile host="drawio"><diagram name="3 How we measure" id="3_How_we_measure"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;3. How we know if it works&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Left to right: from the questions we wrote to the targets the supervisor sets. Below: rules that must never break are tested pass or fail, not measured." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Answer key&lt;/b&gt;&lt;br&gt;26 questions, each with its node and the right sources&lt;br&gt;&lt;i&gt;case_study/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Key facts&lt;/b&gt;&lt;br&gt;what a right answer must contain&lt;br&gt;";" means and, "|" means or&lt;br&gt;&lt;i&gt;metrics/key_facts.csv&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="210" height="110" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;5 grading rules&lt;/b&gt;&lt;br&gt;GR1 key facts present&lt;br&gt;GR2 says "insufficient knowledge"&lt;br&gt;GR3 states the conflict&lt;br&gt;GR4 cites the duplicate once&lt;br&gt;GR5 citations valid' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="100" width="220" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;28 metrics&lt;/b&gt;&lt;br&gt;in 8 objectives (O1 to O8)&lt;br&gt;16 have a baseline now&lt;br&gt;&lt;i&gt;metrics/metrics.csv&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Baseline (part 2)&lt;/b&gt;&lt;br&gt;the first measured value of each metric" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="190" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Targets&lt;/b&gt;&lt;br&gt;set with the supervisor&lt;br&gt;&lt;b&gt;not set yet&lt;/b&gt;: never invent a number" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="190" height="110" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Some baseline numbers (from docs/baseline_report.md)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="700" height="25" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;0.913&lt;/b&gt;&lt;br&gt;Answer correctness" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;0.870&lt;/b&gt;&lt;br&gt;Citation validity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Correct refusal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Context recall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Version handling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;1.000&lt;/b&gt;&lt;br&gt;Scanned text recovery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="295" width="160" height="65" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;0.572&lt;/b&gt;&lt;br&gt;Context precision&lt;br&gt;(many retrieved chunks are not needed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="245" height="75" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;0.000&lt;/b&gt;&lt;br&gt;Duplicate cited once&lt;br&gt;(the model cited D12 and its copy)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="285" y="380" width="245" height="75" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;0.70 s&lt;/b&gt; median question time&lt;br&gt;&lt;b&gt;37.5&lt;/b&gt; tokens per second" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="550" y="380" width="245" height="75" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;10 hard rules: tested, never measured&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="700" height="25" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Hard rules (examples)&lt;/b&gt;&lt;br&gt;H01 a node answers only from its own documents&lt;br&gt;H03 one active version per knowledge item&lt;br&gt;H06 runs with the network off&lt;br&gt;H09 every answer cites a source or says insufficient knowledge&lt;br&gt;&lt;i&gt;metrics/hard_rules.csv&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="525" width="420" height="130" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;64 unit tests&lt;/b&gt; (pytest)&lt;br&gt;fake models, no network&lt;br&gt;&lt;i&gt;tests/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="525" width="220" height="75" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;run_checks.py&lt;/b&gt;&lt;br&gt;6 validators over the data and pages&lt;br&gt;&lt;i&gt;tools/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="615" width="220" height="75" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Later (part 11): the LLM judge&lt;/b&gt;&lt;br&gt;a model scores transfer packages out of 20; below 18 is never sent up (H05). Judges have biases, so we check them against humans." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="525" width="400" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
