<mxfile host="drawio"><diagram name="4 Roadmap and team" id="4_Roadmap_and_team"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;4. Roadmap and who does what&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The proposal has 16 parts. Green is done, blue is next. Names from the proposal, section 21." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Part 1&lt;/b&gt;&lt;br&gt;Start and domain discovery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Part 2&lt;/b&gt;&lt;br&gt;Offline models and baseline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Part 3&lt;/b&gt;&lt;br&gt;DDD architecture and domain model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Part 4&lt;/b&gt;&lt;br&gt;Document ingestion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Part 5&lt;/b&gt;&lt;br&gt;Versioning, chunking, duplicates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Part 6&lt;/b&gt;&lt;br&gt;Nodes, layers, hierarchy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Part 7&lt;/b&gt;&lt;br&gt;Issues and sub-issues" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Part 8&lt;/b&gt;&lt;br&gt;RAG retrieval and Q&amp;amp;A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1245" y="100" width="155" height="80" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Part 9&lt;/b&gt;&lt;br&gt;Executors and IKE relations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Part 10&lt;/b&gt;&lt;br&gt;LLM judge and quality control" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="195" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Part 11&lt;/b&gt;&lt;br&gt;Node cycles and upward transfer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Part 12&lt;/b&gt;&lt;br&gt;Projects, research, gaps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="545" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Part 13&lt;/b&gt;&lt;br&gt;RFP and proposals" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Part 14&lt;/b&gt;&lt;br&gt;Prompt testing and tuning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Part 15&lt;/b&gt;&lt;br&gt;Unit tests and hardening" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1070" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c27" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Part 16&lt;/b&gt;&lt;br&gt;Wrap-up and presentation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1245" y="210" width="155" height="80" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=12;strokeColor=#555555;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;The team for the next weeks&lt;/b&gt; (details: &lt;i&gt;docs/team_plan.md&lt;/i&gt;)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="900" height="25" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;You (lead)&lt;/b&gt;&lt;br&gt;Parts 3 and 4 built: review them with the supervisor&lt;br&gt;Then Part 5&lt;br&gt;Merge work, run the checks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Teammate A: questions&lt;/b&gt;&lt;br&gt;Write 10 unseen questions + key facts.&lt;br&gt;You never saw the prompts, so your questions are a fair test." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Teammate B: runs&lt;/b&gt;&lt;br&gt;Follow the operator guide: rerun with qwen3:4b-instruct, the Wi-Fi-off run, record ollama ps." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Teammate C: ingestion&lt;/b&gt;&lt;br&gt;Test the ingestion prototype on real Word, PDF and DOC files, and the image-only D19 PDF." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="370" width="300" height="120" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;The working rule&lt;/b&gt;&lt;br&gt;Teammates write only in &lt;i&gt;team/&amp;lt;name&amp;gt;/&lt;/i&gt;. The lead copies the work into the project, then runs the checks and the tests. So nobody breaks the project by accident." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="630" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
